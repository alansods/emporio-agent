{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "{emporio_agent/**,data/*.csv,data/politicas.txt}",
      "excludeFiles": "{node_modules/**,.next/**,tests/**,__tests__/**,docs/**,openspec/**,examples/**,data/*.pdf}"
    }
  }
}
