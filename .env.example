# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey). Server side only.
GEMINI_API_KEY=

# Optional: Gemini model id. Default: gemini-3.5-flash-lite
# MODEL=gemini-3.5-flash-lite

# Optional: date treated as "today" for return deadlines (ISO 8601).
# Default: the day after the last order in data/orders.csv (2026-03-23).
# REFERENCE_DATE=2026-03-23
